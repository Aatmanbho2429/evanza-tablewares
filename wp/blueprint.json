{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": { "WP_DEBUG": true, "WP_DEBUG_DISPLAY": true, "WP_DEBUG_LOG": true }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Evanza Tablewares",
        "blogdescription": "Crafted for coffee lovers.",
        "permalink_structure": "/%postname%/"
      }
    },
    { "step": "activateTheme", "themeFolderName": "evanza" }
  ]
}
